<?xml version="1.0" encoding="utf-8"?>
<!-- Autorise le http (sans chiffrement) en plus du https, car le site BOXIBY peut être hébergé sans SSL. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
